{
  "permissions": {
    "allow": [
      "Bash(python3 -I -B .agents/workflows/ship-fix/scripts/*)",
      "Bash(python3 -I -B ./.agents/workflows/ship-fix/scripts/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PROJECT_DIR}/.claude/hooks/claude_pre_tool_use.py\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  }
}
